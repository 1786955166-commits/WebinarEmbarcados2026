&pinctrl {
 uart0_default: uart0_default {
  group1 {
   pinmux = <(((0) << 5) | ((2) << 0))>;
  };

  group2 {
   pinmux = <(((1) << 5) | ((2) << 0))>;
   input-enable;
  };
 };

 i2c0_default: i2c0_default {
  group1 {
   pinmux = <(((4) << 5) | ((3) << 0))>, <(((5) << 5) | ((3) << 0))>;
   input-enable;
   input-schmitt-enable;
  };
 };

 i2c1_default: i2c1_default {
  group1 {
   pinmux = <(((6) << 5) | ((3) << 0))>, <(((7) << 5) | ((3) << 0))>;
   input-enable;
   input-schmitt-enable;
  };
 };

 spi0_default: spi0_default {
  group1 {
   pinmux = <(((17) << 5) | ((1) << 0))>, <(((18) << 5) | ((1) << 0))>, <(((19) << 5) | ((1) << 0))>;
  };

  group2 {
   pinmux = <(((16) << 5) | ((1) << 0))>;
   input-enable;
  };
 };

 pwm_ch4b_default: pwm_ch4b_default {
  group1 {
   pinmux = <(((25) << 5) | ((4) << 0))>;
  };
 };

 adc_default: adc_default {
  group1 {
   pinmux = <(((26) << 5) | ((0xf) << 0))>, <(((27) << 5) | ((0xf) << 0))>, <(((28) << 5) | ((0xf) << 0))>, <(((29) << 5) | ((0xf) << 0))>;
   input-enable;
  };
 };
};
