/ {
 chosen {
  zephyr,console = &cdc_acm_uart0;
  zephyr,shell-uart = &cdc_acm_uart0;
 };


 relays {
  compatible = "gpio-leds";
  relay1: relay_1 { gpios = <&gpio0 21 (0 << 0)>; label = "Relay CH1"; };
  relay2: relay_2 { gpios = <&gpio0 20 (0 << 0)>; label = "Relay CH2"; };
  relay3: relay_3 { gpios = <&gpio0 19 (0 << 0)>; label = "Relay CH3"; };
  relay4: relay_4 { gpios = <&gpio0 18 (0 << 0)>; label = "Relay CH4"; };
  relay5: relay_5 { gpios = <&gpio0 17 (0 << 0)>; label = "Relay CH5"; };
  relay6: relay_6 { gpios = <&gpio0 16 (0 << 0)>; label = "Relay CH6"; };
  relay7: relay_7 { gpios = <&gpio0 15 (0 << 0)>; label = "Relay CH7"; };
  relay8: relay_8 { gpios = <&gpio0 14 (0 << 0)>; label = "Relay CH8"; };
 };


 pwmleds {
  compatible = "pwm-leds";
  buzzer0: buzzer0 {
   pwms = <&pwm 6 (((((1UL) * 1000UL) * 1000UL) * 1000UL) / (1000)) (0 << 0)>;
   label = "Buzzer";
  };
 };

 aliases {
  relay1 = &relay1;
  relay2 = &relay2;
  relay3 = &relay3;
  relay4 = &relay4;
  relay5 = &relay5;
  relay6 = &relay6;
  relay7 = &relay7;
  relay8 = &relay8;
  pwm-buzzer0 = &buzzer0;
  led-strip = &ws2812;
 };

 fstab {
  compatible = "zephyr,fstab";
  lfs1: lfs1 {
   compatible = "zephyr,fstab,littlefs";
   read-size = <16>;
   prog-size = <256>;
   cache-size = <256>;
   lookahead-size = <128>;
   block-cycles = <512>;
   partition = <&storage_partition>;
   mount-point = "/lfs1";
  };
 };
};


&pinctrl {
 pwm_ch3a_default: pwm_ch3a_default {
  group1 {
   pinmux = <(((6) << 5) | ((4) << 0))>;
  };
 };

 pio1_ws2812_default: pio1_ws2812_default {
  ws2812 {
   pinmux = <(((13) << 5) | ((7) << 0))>;
  };
 };
};


&pwm {
 status = "okay";
 pinctrl-0 = <&pwm_ch3a_default>;
 pinctrl-names = "default";
};


&pio1 {
 status = "okay";

 pio1_ws2812: pio1_ws2812 {
  compatible = "worldsemi,ws2812-rpi_pico-pio";
  status = "okay";
  pinctrl-0 = <&pio1_ws2812_default>;
  pinctrl-names = "default";
  bit-waveform = <3>, <3>, <4>;

  ws2812: ws2812 {
   gpios = <&gpio0 13 (0 << 0)>;
   chain-length = <1>;
   color-mapping = <2
      1
      3>;
   reset-delay = <280>;
   frequency = <800000>;
  };
 };
};


&rtc {
 status = "okay";
};
